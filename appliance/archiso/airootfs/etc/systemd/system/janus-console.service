[Unit]
Description=Janus Directory Console (web UI)
After=network.target janus-provision.service
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/opt/janusos
EnvironmentFile=-/etc/janus/janus.env
ExecStart=/opt/janusos/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
