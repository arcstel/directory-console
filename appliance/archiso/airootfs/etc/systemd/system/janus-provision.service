[Unit]
Description=Janus Directory Console first-run provisioning
After=network.target
Before=samba-ad-dc.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/janus/janus.env
ExecStart=/usr/local/bin/janus-provision
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
