# Environment for the console service. Overwritten by the provisioner once a
# domain exists (with the real realm, base DN, and bind credentials).
JANUS_APPLIANCE=1
LDAP_URI=ldaps://127.0.0.1:636
LDAP_BASE_DN=DC=example,DC=local
LDAP_BIND_USER=Administrator@example.local
LDAP_BIND_PASS=Passw0rd!2026
LDAP_TLS_VERIFY=false
