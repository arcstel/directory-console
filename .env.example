# Copy to .env and adjust as needed.
DOMAIN=EXAMPLE
REALM=EXAMPLE.LOCAL
ADMIN_PASS=Passw0rd!2026
DNS_FORWARDER=1.1.1.1
SEED=true

# Console
CONSOLE_PORT=8000
LDAP_URI=ldaps://dc:636
LDAP_BASE_DN=DC=example,DC=local
LDAP_BIND_USER=Administrator@example.local
LDAP_BIND_PASS=Passw0rd!2026
LDAP_TLS_VERIFY=false
DEFAULT_USER_PASSWORD=ChangeMe!2026

# Set to 1 to run the UI against built-in sample data with no DC.
DCC_MOCK=0
